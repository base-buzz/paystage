{
  "name": "@paystage/preflight",
  "version": "0.5.3",
  "description": "agent spend policy enforcement: stop your agent paying a drainer before the wallet signs. Returns pay / review / do_not_pay from a local policy, with the rule that fired. No keys, no signing.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "paystage-preflight-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "!dist/**/*.map"
  ],
  "mcpName": "io.github.base-buzz/preflight",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payment-safety",
    "x402",
    "agent-payments",
    "spend-limits",
    "drainer",
    "firewall",
    "allowlist",
    "blocklist",
    "scam-prevention",
    "usdc",
    "base",
    "mcp",
    "preflight",
    "policy",
    "evaluation",
    "payment safety",
    "spend limit",
    "spend limits",
    "agent payment safety",
    "stop agent paying drainer",
    "limit agent spending usdc",
    "agent spending limits",
    "budget"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/preflight"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@paystage/policy": "0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
