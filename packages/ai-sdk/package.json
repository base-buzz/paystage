{
  "name": "@paystage/ai-sdk",
  "version": "0.1.4",
  "description": "Stop your agent paying a drainer: PayStage preflight as AI SDK tools, so the payment is checked inside the same loop that would sign it. pay / review / do_not_pay.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "keywords": [
    "payment-safety",
    "x402",
    "agent-payments",
    "spend-limits",
    "drainer",
    "firewall",
    "allowlist",
    "blocklist",
    "scam-prevention",
    "usdc",
    "base",
    "mcp",
    "preflight",
    "ai-sdk",
    "vercel",
    "payments",
    "agents",
    "vercel-ai",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/base-buzz/paystage",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://paystage.xyz/ai-sdk",
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@paystage/preflight": "0.5.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": ">=5"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
