{
  "name": "@paystage/mcp",
  "version": "0.8.3",
  "description": "x402 payment safety and agent spend limits: nine MCP tools that check an x402 payment before your wallet signs. pay / review / do_not_pay, with the rule that fired. Read-only \u2014 holds no keys.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "bin": {
    "paystage-mcp": "dist/cli.js",
    "paystage-verify": "dist/verify-cli.js",
    "paystage-policy": "dist/policy-cli.js",
    "paystage-explain": "dist/explain-cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "!dist/**/*.map"
  ],
  "mcpName": "io.github.base-buzz/mcp",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payment-safety",
    "x402",
    "agent-payments",
    "spend-limits",
    "drainer",
    "firewall",
    "allowlist",
    "blocklist",
    "scam-prevention",
    "usdc",
    "base",
    "mcp",
    "preflight",
    "paystage",
    "hip-3",
    "trade",
    "guard",
    "policy",
    "velocity",
    "receipt",
    "verification",
    "payment safety",
    "spend limit",
    "spend limits",
    "agent payment safety"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@paystage/auth-watch": "0.2.0",
    "@paystage/policy": "0.2.1",
    "@paystage/preflight": "0.3.0",
    "@paystage/trade-preflight": "0.2.0",
    "@paystage/velocity": "0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/verify-cli.js dist/policy-cli.js dist/explain-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
