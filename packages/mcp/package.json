{
  "name": "@paystage/mcp",
  "version": "0.2.0",
  "description": "PayStage umbrella MCP: payment preflight, auth watch, and HIP-3 trade preflight, and rate/spend-pattern velocity checks",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paystage-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "mcpName": "xyz.paystage/mcp",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "x402",
    "agent-payments",
    "usdc",
    "base",
    "paystage",
    "hip-3",
    "trade"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@paystage/policy": "0.1.0",
    "@paystage/preflight": "0.1.0",
    "@paystage/auth-watch": "0.1.0",
    "@paystage/trade-preflight": "^0.1.2",
    "zod": "^3.23.8",
    "@paystage/velocity": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
