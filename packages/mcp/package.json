{
  "name": "@paystage/mcp",
  "version": "0.3.4",
  "description": "PayStage umbrella MCP: payment preflight, auth watch, HIP-3 trade preflight, and velocity rate/spend-pattern checks",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "paystage-mcp": "dist/cli.js",
    "paystage-verify": "dist/verify-cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "!dist/**/*.map"
  ],
  "mcpName": "io.github.base-buzz/mcp",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "x402",
    "agent-payments",
    "usdc",
    "base",
    "paystage",
    "hip-3",
    "trade"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@paystage/auth-watch": "0.2.1",
    "@paystage/policy": "0.2.1",
    "@paystage/preflight": "0.2.3",
    "@paystage/trade-preflight": "0.2.1",
    "@paystage/velocity": "0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/verify-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
