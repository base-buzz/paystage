{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.base-buzz/mcp",
  "title": "PayStage \u2014 x402 payment safety",
  "description": "x402 payment safety: stop your agent paying a drainer and limit agent spending before the wallet signs.",
  "version": "0.8.4",
  "websiteUrl": "https://paystage.xyz",
  "repository": {
    "url": "https://github.com/base-buzz/paystage",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@paystage/mcp",
      "version": "0.8.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PAYSTAGE_POLICY_PATH",
          "description": "Path to policy.json spending rules",
          "isRequired": false
        },
        {
          "name": "PAYSTAGE_RPC_URL",
          "description": "Base RPC URL override",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.paystage.xyz/mcp"
    }
  ]
}
