{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.base-buzz/mcp",
  "title": "PayStage",
  "description": "Umbrella MCP: payment preflight, auth watch, HIP-3 trade preflight, velocity checks",
  "version": "0.3.3",
  "websiteUrl": "https://paystage.xyz",
  "repository": {
    "url": "https://github.com/base-buzz/paystage",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@paystage/mcp",
      "version": "0.3.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PAYSTAGE_POLICY_PATH",
          "description": "Path to policy.json spending rules",
          "isRequired": false
        },
        {
          "name": "PAYSTAGE_RPC_URL",
          "description": "Base RPC URL override",
          "isRequired": false
        }
      ]
    }
  ]
}
