{
  "name": "@paystage/x402-guard",
  "version": "0.4.1",
  "description": "Stop your agent paying a drainer: a policy gate for x402 clients that runs before the wallet signs. Blocks over-cap payments, unknown payees and sanctioned addresses, and says which rule fired.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/x402-guard"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payment-safety",
    "x402",
    "agent-payments",
    "spend-limits",
    "drainer",
    "firewall",
    "allowlist",
    "blocklist",
    "scam-prevention",
    "usdc",
    "base",
    "mcp",
    "preflight",
    "x402-fetch",
    "payment-policy",
    "sanctioned",
    "ofac",
    "wallet",
    "guard"
  ],
  "dependencies": {
    "@paystage/policy": "0.2.1",
    "@paystage/preflight": "0.3.0",
    "@x402/extensions": "^2.29.0"
  },
  "peerDependencies": {
    "x402-fetch": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "x402-fetch": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
