{
  "name": "@paystage/x402-guard",
  "version": "0.5.0",
  "description": "a payment firewall for x402 clients and mcp payment firewall for x402-fetch: stop your agent paying a drainer before it signs. Blocks over-cap payments, unknown payees and OFAC-sanctioned addresses, and names the rule that fired.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/x402-guard"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signer": {
      "types": "./dist/signer.d.ts",
      "import": "./dist/signer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payment-safety",
    "x402",
    "agent-payments",
    "spend-limits",
    "drainer",
    "firewall",
    "allowlist",
    "blocklist",
    "scam-prevention",
    "usdc",
    "base",
    "mcp",
    "preflight",
    "x402-fetch",
    "payment-policy",
    "sanctioned",
    "ofac",
    "wallet",
    "guard",
    "payment safety",
    "spend limit",
    "spend limits",
    "agent payment safety",
    "stop-paying-drainer",
    "block-drainer-payments",
    "drainer-protection",
    "limit-agent-spending",
    "spending-cap",
    "refuse-bad-payment",
    "stop agent paying drainer",
    "limit agent spending usdc",
    "agent spending limits",
    "budget"
  ],
  "dependencies": {
    "@paystage/policy": "0.4.1",
    "@paystage/preflight": "0.6.1",
    "@paystage/receipt-verify": "0.1.0",
    "@x402/extensions": "^2.29.0"
  },
  "peerDependencies": {
    "viem": ">=2.21.0",
    "x402-fetch": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "x402-fetch": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.12",
    "x402-fetch": "^0.8.0",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "viem": "^2.21.0"
  },
  "mcpName": "io.github.base-buzz/x402-guard"
}
