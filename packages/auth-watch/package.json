{
  "name": "@paystage/auth-watch",
  "version": "0.2.1",
  "description": "List and evaluate outstanding ERC-20 / Permit2 / EIP-3009 authorizations for an agent wallet (read-only)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paystage-auth-watch": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "!dist/**/*.map"
  ],
  "mcpName": "xyz.paystage/auth-watch",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "x402",
    "agent-payments",
    "usdc",
    "base",
    "auth-watch",
    "permit2"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/auth-watch"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@paystage/policy": "0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  }
}
