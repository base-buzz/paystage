{
  "name": "@paystage/x-evm",
  "version": "0.1.1",
  "description": "PayStage guard for @x402/evm \u2014 evaluate the payment requirements before the EVM scheme signs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/x-evm"
  },
  "keywords": [
    "x402",
    "evm",
    "agent-payments",
    "preflight",
    "guard"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@x402/evm": ">=2.29.0"
  },
  "peerDependenciesMeta": {
    "@x402/evm": {
      "optional": true
    }
  },
  "dependencies": {
    "@paystage/preflight": "0.2.3",
    "@paystage/policy": "0.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
