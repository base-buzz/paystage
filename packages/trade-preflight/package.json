{
  "name": "@paystage/trade-preflight",
  "version": "0.2.0",
  "description": "Evaluate HIP-3/trade.xyz orders against a local TradePolicy before an agent trades",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paystage-trade-preflight": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "!dist/**/*.map"
  ],
  "mcpName": "xyz.paystage/trade-preflight",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hyperliquid",
    "hip-3",
    "trade.xyz",
    "preflight",
    "policy",
    "agent-trading"
  ],
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/trade-preflight"
  },
  "bugs": {
    "url": "https://github.com/base-buzz/paystage/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
