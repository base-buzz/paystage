{
  "name": "@paystage/velocity",
  "version": "0.2.0",
  "description": "Rolling-window rate and spend-pattern checks for agent payments.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paystage-velocity": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@paystage/policy": "0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.12",
    "@types/node": "^20.14.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://paystage.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/base-buzz/paystage.git",
    "directory": "packages/velocity"
  },
  "publishConfig": {
    "access": "public"
  }
}
