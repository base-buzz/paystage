{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "xyz.paystage/mcp",
  "description": "Umbrella MCP server for AI agent payment safety. Exposes evaluate_mcp_payment, list_outstanding_auths, and evaluate_outstanding_auths, returning pay, review, or do_not_pay.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/base-buzz/paystage",
    "source": "github"
  },
  "websiteUrl": "https://paystage.xyz/",
  "packages": [
    {
      "registryType": "npm",
      "registryName": "npm",
      "identifier": "@paystage/mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "@paystage/mcp"
        }
      ]
    }
  ]
}
