{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "xyz.paystage/preflight",
  "description": "MCP payment preflight server for AI agent payments. Evaluates x402 payments against a local policy and returns pay, review, or do_not_pay.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/base-buzz/paystage",
    "source": "github"
  },
  "websiteUrl": "https://paystage.xyz/",
  "packages": [
    {
      "registryType": "npm",
      "registryName": "npm",
      "identifier": "@paystage/preflight",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "@paystage/preflight"
        }
      ]
    }
  ]
}
