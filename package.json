{
  "name": "paystage",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @paystage/policy -w @paystage/payment-policy -w @paystage/receipt-verify -w @paystage/mandate -w @paystage/pass -w @paystage/preflight -w @paystage/x402-guard -w @paystage/x-evm -w @paystage/auth-watch -w @paystage/channel -w @paystage/velocity -w @paystage/trade-preflight -w @paystage/ai-sdk -w @paystage/mcp -w @paystage/n8n -w @paystage/eliza-plugin",
    "test": "npm run test -w @paystage/policy -w @paystage/payment-policy -w @paystage/receipt-verify -w @paystage/mandate -w @paystage/pass -w @paystage/preflight -w @paystage/auth-watch -w @paystage/channel -w @paystage/velocity -w @paystage/x402-guard -w @paystage/trade-preflight -w @paystage/mcp -w @paystage/n8n -w @paystage/eliza-plugin",
    "typecheck": "npm run typecheck -w @paystage/policy -w @paystage/payment-policy -w @paystage/receipt-verify -w @paystage/mandate -w @paystage/pass -w @paystage/preflight -w @paystage/auth-watch -w @paystage/velocity -w @paystage/trade-preflight -w @paystage/mcp -w paystage-hosted",
    "check:dep-pins": "node scripts/check-dep-pins.mjs",
    "conformance": "node scripts/conformance.mjs",
    "check:live": "node scripts/check-deployed-sha.mjs --remote && node scripts/check-mcp-live.mjs && node scripts/check-receipt-live.mjs && node scripts/check-sanctions-live.mjs",
    "brand:render": "node scripts/brand-kit.mjs",
    "brand:rebuild": "node scripts/brand-rebuild.mjs",
    "brand:manifest": "node scripts/record-brand-manifest.mjs",
    "brand:pngs": "node scripts/gen-brand-png-module.mjs",
    "brand:verify": "node scripts/check-brand-assets.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
