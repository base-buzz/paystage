# Rendered by `scripts/render-wrangler.mjs` from the repo-root brand.json. Do not edit the
# generated wrangler.toml and do not add the Worker name or domain here as literals: the
# generated file is gitignored so a fork cannot commit one host's values.
#
# Deploy method copied from apps/console/wrangler.toml: OpenNext build output served by a
# Worker with a static-assets binding.
name = "__WORKER_NAME__"
main = ".open-next/worker.js"
compatibility_date = "2024-12-30"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[assets]
directory = ".open-next/assets"
binding = "ASSETS"

# Both names are custom domains; Cloudflare manages their DNS once the route is attached.
[[routes]]
pattern = "__DOMAIN__"
custom_domain = true

[[routes]]
pattern = "www.__DOMAIN__"
custom_domain = true
