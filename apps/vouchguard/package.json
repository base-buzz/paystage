{
  "name": "@paystage/vouchguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-brand.mjs && node scripts/copy-pass-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-brand.mjs && node scripts/copy-pass-assets.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:prod": "node scripts/check-brand.mjs && node scripts/render-wrangler.mjs && npx opennextjs-cloudflare build && npx wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.7.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "5.7.3",
    "wrangler": "^4.0.0"
  }
}
