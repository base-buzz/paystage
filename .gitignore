node_modules
dist
.env
coverage
*.tsbuildinfo
*.tgz

# Harness and probe artefacts. The client harness runs from /work/clients (outside this repo) and keeps keys in the vault,
# but a stray copy of its state must never be committable: a wallet address is fine, a journal of 100 addresses beside a
# run log is a target list.
clients/
*.journal.jsonl
journal.jsonl
last-tick
probe_runs.json
apps/console/.lab-cache/

# Private records and credentials — a public repo is not the place for either (#441).
# `.research-ledger/` held 588 KB of our own evidence objects, one of them a 437 KB snapshot of the internal
# backlog; it was tracked for a week. `check-staged-secrets.mjs` fails on these paths, because a .gitignore is a
# hope and a check is a rule.
.research-ledger/
.env
.env.*
.dev.vars
.dev.vars*
*.p12
*.pem
*.mobileprovision

# The loop's frames are generated (240 PNGs, ~17 MB). The script and the README are the artefact; the frames are a build
# product, regenerated by `node scripts/render-loop.mjs` from the mark's geometry.
brand/loop/*.png

# Schema migrations are no longer published (operator override, 2026-11-28). They remain in git history;
# a rewrite would change every commit SHA cited in public posts, so history is left alone deliberately.
supabase/migrations/
