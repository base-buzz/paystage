#!/usr/bin/env bash
# Pre-push gate. Three cheap checks that have each caught a real defect this month.
#
# Enabled with: git config core.hooksPath .githooks
# Bypass once with: git push --no-verify  (say why in the commit, not in silence)
set -uo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

fail=0
note() { printf 'pre-push: %s\n' "$1"; }

# 1. Every package declares what it builds. @paystage/mcp shipped .d.ts files with no
#    "types" field for three releases; nobody noticed because nobody imported it in TS.
if ! node scripts/check-manifests.mjs; then
  note "manifests failed — a package would ship untyped"
  fail=1
fi

# 2. Copy drift: a README that hardcodes a version goes stale the next release, and nobody
#    reads a README to find out it is wrong. Local links only here — network checks stay in
#    CI so a push never waits on someone else's server.
if ! node scripts/check-claims.mjs >/tmp/prepush-claims.txt 2>&1; then
  note "copy claims drifted from the code — see /tmp/prepush-claims.txt"
  cat /tmp/prepush-claims.txt
  exit 1
fi

# The same claim written in three places (README, lander, inventory) drifted within a week: four
# destinations in one, six in another, and one badge claiming a listing nothing had verified.
# Tool tables are generated from packages/mcp/src/tools.ts. Hand-written tables drifted three times this
# week (five of nine, four of nine, and one stale table above a correct one), so the table is no longer
# hand-written at all.
if ! node scripts/sync-tool-docs.mjs --check >/tmp/prepush-tools.txt 2>&1; then
  note "a tool table is stale — run: node scripts/sync-tool-docs.mjs --write"
  grep DRIFT /tmp/prepush-tools.txt | sed 's/^/    /'
  fail=1
fi

# The runnable example asserts the four verdicts; if behaviour moves, this fails before the demo misleads anyone.
if ! node examples/run.mjs >/tmp/prepush-examples.txt 2>&1; then
  note "examples/run.mjs no longer matches the product — read /tmp/prepush-examples.txt"
  tail -6 /tmp/prepush-examples.txt | sed 's/^/    /'
  fail=1
fi

# The privacy page must describe the telemetry we actually write; understating collection is a lie with a footer link.
if ! node scripts/check-contrast.mjs >/tmp/prepush-contrast.txt 2>&1; then
  note "a text token fails WCAG AA — read /tmp/prepush-contrast.txt"
  grep FAIL /tmp/prepush-contrast.txt | sed 's/^/    /'
  fail=1
fi

if ! node scripts/sync-glossary.mjs --check >/tmp/prepush-glossary.txt 2>&1; then
  note "the glossary's generated copy is stale — run: node scripts/sync-glossary.mjs --write"
  fail=1
fi

if ! node scripts/check-privacy.mjs >/tmp/prepush-privacy.txt 2>&1; then
  note "the privacy page no longer matches telemetry — read /tmp/prepush-privacy.txt"
  grep DRIFT /tmp/prepush-privacy.txt | sed 's/^/    /'
  fail=1
fi

if ! node scripts/check-listing-copy.mjs >/tmp/prepush-listings.txt 2>&1; then
  note "where-we-are-listed drifted — README and the lander name different destinations"
  grep "DRIFT" /tmp/prepush-listings.txt | sed 's/^/    /'
  fail=1
fi

if ! node scripts/check-copy.mjs >/tmp/prepush-copy.txt 2>&1; then
  note "copy check failed — a README names a stale version or a dead link"
  tail -6 /tmp/prepush-copy.txt | sed 's/^/    /'
  fail=1
fi

# 6. Internal doc links resolve (pre-push).
if ! node scripts/check-doc-links.mjs; then
  note "internal doc links are broken — see output above"
  fail=1
fi

# 7. One version, one number: server.json, package.json and the console's tool count must agree.
if ! node scripts/check-version-parity.mjs >/tmp/prepush-parity.txt 2>&1; then
  note "version parity failed — a manifest describes a version nobody can install"
  tail -6 /tmp/prepush-parity.txt | sed 's/^/    /'
  fail=1
fi

# 8. Every hosted route is in the agent-facing documents, and every documented endpoint exists.
if ! node scripts/check-route-docs.mjs; then
  note "route documentation drifted — an endpoint an agent cannot find does not exist for it"
  fail=1
fi

# 9. apps/hosted is outside the workspace: its file: deps must resolve and be in its own lockfile.
if ! node scripts/check-hosted-deps.mjs; then
  note "apps/hosted dependency drift — the deploy will fail on an unresolved import"
  fail=1
fi

# 10. Run what CI runs: build, every test suite, and a clean-checkout pass when the push touches something that can
#     only break on a fresh install (a lockfile, a manifest, a workflow, this hook).
#
#     This is the answer to "can it be checked before it hits GitHub". Every failure today was green locally and red on
#     CI, because the local tree had been installed for hours: a workflow with no node_modules, a package built against
#     stale dependencies, a test asserting a count that had moved. A working tree cannot see those; a clean checkout can.
if ! node scripts/ci-local.mjs; then
  note "CI would fail on this commit — see above"
  fail=1
fi

# 11. The OpenAPI document is a contract, not a summary: use/don't-use, formats, problem responses.
if ! node scripts/check-openapi-contract.mjs; then
  note "the agent-facing OpenAPI document lost its contract details"
  fail=1
fi

# 3. Any dependency added in this push gets scored before it lands.
base=$(git merge-base HEAD origin/main 2>/dev/null || echo "")
if [ -n "$base" ]; then
  added=$(git diff "$base" HEAD -- 'packages/*/package.json' 'package.json' \
    | grep -E '^\+\s+"[^"]+":\s+"[\^~0-9]' \
    | sed -E 's/^\+\s+"([^"]+)".*/\1/' \
    | grep -v '^@paystage/' | sort -u)
  if [ -n "$added" ]; then
    for dep in $added; do
      if ! node scripts/npm-check.mjs "$dep" >/tmp/prepush-dep.txt 2>&1; then
        status=$?
        note "dependency $dep scored exit $status — read /tmp/prepush-dep.txt"
        sed -n '1,10p' /tmp/prepush-dep.txt | sed 's/^/    /'
        [ "$status" = "1" ] && fail=1
      fi
    done
  fi
fi

# 4. A push that changes source must typecheck. Skipped for docs-only pushes.
if [ -n "$base" ] && git diff --name-only "$base" HEAD | grep -qE '^(packages|apps)/.*\.(ts|tsx)$'; then
  if ! npm run typecheck >/tmp/prepush-tc.txt 2>&1; then
    note "typecheck failed — see /tmp/prepush-tc.txt"
    tail -5 /tmp/prepush-tc.txt | sed 's/^/    /'
    fail=1
  fi
fi

if [ "$fail" = "1" ]; then
  note "blocked. Fix above, or push with --no-verify and say why."
  exit 1
fi
note "ok"
