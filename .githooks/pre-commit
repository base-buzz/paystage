#!/usr/bin/env bash
# What has to be caught before the commit exists.
#
# Secrets are the one mistake a revert cannot fix: the blob stays in history and in every clone. Every other check in
# this repo runs at pre-push, where the commit is already made and can still be amended; this one runs earlier because
# `git commit --amend` is not the same as not committing.
#
# The JavaScript validity check lives here too, for the same reason: a `.mjs` with TypeScript syntax is a syntax error
# that reads like ordinary code in a diff.
set -u

fail=0

if ! node scripts/check-staged-secrets.mjs; then
  fail=1
fi

for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(mjs|js)$' || true); do
  [ -f "$f" ] || continue
  if ! err=$(node --check "$f" 2>&1); then
    echo "pre-commit: $f is not valid JavaScript"
    echo "$err" | head -3 | sed 's/^/    /'
    fail=1
  fi
done

# PROVENANCE.md records a hash of the files it describes, so it goes stale the moment one of them changes — and the failure surfaced at
# pre-push, after the work, which cost a second commit three times on 2026-11-28. Regenerating here moves the fix to before the commit:
# same guarantee, one fewer commit, and the file can never be committed stale.
if git diff --cached --name-only | grep -qE '^(SECURITY\.md|apps/hosted/README\.md|PROVENANCE\.md)$'; then
  if ! node scripts/gen-provenance-table.mjs >/dev/null 2>&1; then
    echo "pre-commit: could not regenerate PROVENANCE.md — commit blocked rather than committing a stale record"
    fail=1
  elif ! git diff --quiet PROVENANCE.md; then
    git add PROVENANCE.md
    echo "pre-commit: PROVENANCE.md regenerated and staged (it hashes the files it describes)"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: nothing committed."
  exit 1
fi
